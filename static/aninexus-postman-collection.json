      "name": "System & Health",
      "item": [
        {
          "name": "Health Check (Uptime & Metrics)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{healthUrl}}/health",
              "host": [
                "{{healthUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns real-time gateway health, process uptime, and ISO timestamp."
          }
        },
        {
          "name": "API Root Specification Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{healthUrl}}/",
              "host": [
                "{{healthUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Returns API metadata, feature flags, rate limits, and endpoint directory."
          }
        }
      ]
